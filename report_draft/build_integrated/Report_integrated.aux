\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Geometry of the CHAMP gait on a single leg, seen from the side. The dotted closed curve is the cycle described by the foot in its trajectory frame: the upper branch is the swing Bézier~\eqref  {eq:swing}, which clears the ground by the swing height $h_{\mathrm  {sw}}$, and the lower branch is the stance arc~\eqref  {eq:stance}, which presses into the ground by the stance height $h_{\mathrm  {st}}$ and sweeps backwards to carry the trunk forward. The horizontal extent of the cycle is the step length $L_i$ of~\eqref  {eq:steplen}, the only channel through which the commanded twist reaches the leg; the reference point on the ground line is the nominal stance position $\bar  p^{\mathrm  {f}}_i$ about which the Raibert half-step~\eqref  {eq:raibert} displaces the cycle, and the walking height is the nominal trunk height $h_0$. Adapted from the CHAMP documentation \cite  {champ}.}}{7}{figure.caption.13}\protected@file@percent }
\newlabel{fig:gaitparams}{{2}{7}{Geometry of the CHAMP gait on a single leg, seen from the side. The dotted closed curve is the cycle described by the foot in its trajectory frame: the upper branch is the swing Bézier~\eqref {eq:swing}, which clears the ground by the swing height $h_{\mathrm {sw}}$, and the lower branch is the stance arc~\eqref {eq:stance}, which presses into the ground by the stance height $h_{\mathrm {st}}$ and sweeps backwards to carry the trunk forward. The horizontal extent of the cycle is the step length $L_i$ of~\eqref {eq:steplen}, the only channel through which the commanded twist reaches the leg; the reference point on the ground line is the nominal stance position $\bar \pf _i$ about which the Raibert half-step~\eqref {eq:raibert} displaces the cycle, and the walking height is the nominal trunk height $h_0$. Adapted from the CHAMP documentation \cite {champ}}{figure.caption.13}{}}
\newlabel{fig:gaitparams@cref}{{[figure][2][]2}{[1][7][]7}}
