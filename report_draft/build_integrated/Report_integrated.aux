\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces One-factor-at-a-time sweep: closed-loop score against each weight in turn, six rollouts and one $1$-D GP per axis, with the band of~\eqref  {eq:gppost}. Filled markers reach the goal, hollow ones do not; solid line is the axis optimum~\eqref  {eq:axisopt}, dashed the deployed value. $\Delta \mathcal  {J}$, the spread of the six observations, is the only quantity comparable across panels; those containing a failure use a log axis and the rest are zoomed, so the apparent amplitude is not.}}{34}{figure.caption.97}\protected@file@percent }
\newlabel{fig:ofatcurves}{{12}{34}{One-factor-at-a-time sweep: closed-loop score against each weight in turn, six rollouts and one $1$-D GP per axis, with the band of~\eqref {eq:gppost}. Filled markers reach the goal, hollow ones do not; solid line is the axis optimum~\eqref {eq:axisopt}, dashed the deployed value. $\Delta \mathcal {J}$, the spread of the six observations, is the only quantity comparable across panels; those containing a failure use a log axis and the rest are zoomed, so the apparent amplitude is not}{figure.caption.97}{}}
\newlabel{fig:ofatcurves@cref}{{[figure][12][]12}{[1][34][]34}}
