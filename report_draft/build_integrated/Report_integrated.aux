\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Gazebo (right), where the stack was first closed on the Go2 and which now carries the G1 in scripted arena worlds, with the Foxglove front-end used for telemetry (left). The traces are the three components of the twist commanded by the MPC; the 3-D panel shows the accumulated LiDAR returns and the local occupancy grid rebuilt from the newest scan. Gazebo is the fastest of the three simulators and the only one routinely run faster than real time, which is what makes it the one used for regression runs of the whole node graph.}}{36}{figure.caption.99}\protected@file@percent }
\newlabel{fig:sim-gazebo}{{13}{36}{Gazebo (right), where the stack was first closed on the Go2 and which now carries the G1 in scripted arena worlds, with the Foxglove front-end used for telemetry (left). The traces are the three components of the twist commanded by the MPC; the 3-D panel shows the accumulated LiDAR returns and the local occupancy grid rebuilt from the newest scan. Gazebo is the fastest of the three simulators and the only one routinely run faster than real time, which is what makes it the one used for regression runs of the whole node graph}{figure.caption.99}{}}
\newlabel{fig:sim-gazebo@cref}{{[figure][13][]13}{[1][35][]36}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces The G1 in MuJoCo (left), the lighter of the two dynamic simulators and the one the replay bag of Section~\ref {sec:setup} was recorded in. Rendering is deliberately minimal: what MuJoCo is used for is the contact solver, so that the twist published by the MPC is tracked by the gait policy under the dynamics it was trained on. The RViz panel (right) shows the same run from the stack's point of view, with the filtered LiDAR returns, the local occupancy grid, the $A^\star ${} path and the MPC predicted trajectory and setpoint drawn on top of each other.}}{36}{figure.caption.100}\protected@file@percent }
\newlabel{fig:sim-mujoco}{{14}{36}{The G1 in MuJoCo (left), the lighter of the two dynamic simulators and the one the replay bag of Section~\ref {sec:setup} was recorded in. Rendering is deliberately minimal: what MuJoCo is used for is the contact solver, so that the twist published by the MPC is tracked by the gait policy under the dynamics it was trained on. The RViz panel (right) shows the same run from the stack's point of view, with the filtered LiDAR returns, the local occupancy grid, the \astar {} path and the MPC predicted trajectory and setpoint drawn on top of each other}{figure.caption.100}{}}
\newlabel{fig:sim-mujoco@cref}{{[figure][14][]14}{[1][35][]36}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces The G1 in Isaac Sim (left) and the navigation stack running on it (right). The simulated scene supplies both the contact dynamics for the gait policy of Section~\ref {sec:g1rl} and the rendered stereo pair from which the visual--inertial odometry is computed. In the RViz view every display the planner consumes is LiDAR-derived: the marked returns with the ground rejected, the local voxel map, the stop and slow-down zones, and the MPC prediction of Section~\ref {sec:nlp}; the visual odometry appears as a separate track, feeding the pose bridge of Section~\ref {sec:overview} rather than the map.}}{37}{figure.caption.101}\protected@file@percent }
\newlabel{fig:sim-isaac}{{15}{37}{The G1 in Isaac Sim (left) and the navigation stack running on it (right). The simulated scene supplies both the contact dynamics for the gait policy of Section~\ref {sec:g1rl} and the rendered stereo pair from which the visual--inertial odometry is computed. In the RViz view every display the planner consumes is LiDAR-derived: the marked returns with the ground rejected, the local voxel map, the stop and slow-down zones, and the MPC prediction of Section~\ref {sec:nlp}; the visual odometry appears as a separate track, feeding the pose bridge of Section~\ref {sec:overview} rather than the map}{figure.caption.101}{}}
\newlabel{fig:sim-isaac@cref}{{[figure][15][]15}{[1][35][]37}}
