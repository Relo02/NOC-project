\newlabel{sec:memoryfix@cref}{{[subsubsection][2][5,4]5.4.2}{[1][30][]30}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The ten worlds of the campaign: the wide pale trace is the baseline ray projection~\eqref  {eq:localgoal}, the thin dark one the deployed geodesic $\arg \min $~\eqref  {eq:localgoalargmin}, both under limited perception. Heavy frames are the six \emph  {traps}, light frames the four \emph  {controls} that only look like traps; the subtitle gives the distance travelled by each rule. The baseline is drawn underneath and wider on purpose, because wherever the two rules choose the same side the trajectories coincide and one drawn over the other would simply hide it, and because on \emph  {dead end}, \emph  {horseshoe} and \emph  {L-corridor} the $79$ to $153$~m it travels are a limit cycle packed into a few metres at the mouth of the obstacle. In \emph  {long wall, gap north} both rules choose the open side and both arrive; in \emph  {long wall, gap south} the goal offset forces both onto the closed side and both stop there. The controls are what make the result a result: a rule that refused to enter concave-looking scenes would pass every trap and fail all four of these, where the correct behaviour is to drive straight through. The dashed trace appears in the \emph  {long wall, gap south} panel alone and is the reachability fall-through discussed in Section~\ref {sec:memoryfix}; on the other nine worlds it reproduces the deployed run exactly, so drawing it there would only thicken the line.}}{31}{figure.caption.89}\protected@file@percent }
\newlabel{fig:escapegallery}{{11}{31}{The ten worlds of the campaign: the wide pale trace is the baseline ray projection~\eqref {eq:localgoal}, the thin dark one the deployed geodesic $\arg \min $~\eqref {eq:localgoalargmin}, both under limited perception. Heavy frames are the six \emph {traps}, light frames the four \emph {controls} that only look like traps; the subtitle gives the distance travelled by each rule. The baseline is drawn underneath and wider on purpose, because wherever the two rules choose the same side the trajectories coincide and one drawn over the other would simply hide it, and because on \emph {dead end}, \emph {horseshoe} and \emph {L-corridor} the $79$ to $153$~m it travels are a limit cycle packed into a few metres at the mouth of the obstacle. In \emph {long wall, gap north} both rules choose the open side and both arrive; in \emph {long wall, gap south} the goal offset forces both onto the closed side and both stop there. The controls are what make the result a result: a rule that refused to enter concave-looking scenes would pass every trap and fail all four of these, where the correct behaviour is to drive straight through. The dashed trace appears in the \emph {long wall, gap south} panel alone and is the reachability fall-through discussed in Section~\ref {sec:memoryfix}; on the other nine worlds it reproduces the deployed run exactly, so drawing it there would only thicken the line}{figure.caption.89}{}}
\newlabel{fig:escapegallery@cref}{{[figure][11][]11}{[1][30][]31}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Escape from non-convex obstacles under limited perception: the baseline ray projection~\eqref  {eq:localgoal} against the deployed geodesic $\arg \min $~\eqref  {eq:localgoalargmin}, one run each, with the per-world time budget of the simulator. Above the double rule the six traps, below it the four controls. Reversals are changes of sign of the longitudinal velocity, the signature of the limit cycle. Clearance is the closest approach to an obstacle over the whole run, against a body radius of $0.35$~m; on the runs that fail it is the $0.25$~m at which the plant stops the robot against the wall. Time is reported only for runs that reached the goal. The \emph  {long wall, gap north} row is taken at a spawn displaced $0.4$~m along the wall: with the goal on the axis the side is chosen by numerical noise, so a single run there compares the two spawns and not the two rules, and the sweep that establishes this is reported below.}}{32}{table.caption.90}\protected@file@percent }
\newlabel{tab:escape}{{12}{32}{Escape from non-convex obstacles under limited perception: the baseline ray projection~\eqref {eq:localgoal} against the deployed geodesic $\arg \min $~\eqref {eq:localgoalargmin}, one run each, with the per-world time budget of the simulator. Above the double rule the six traps, below it the four controls. Reversals are changes of sign of the longitudinal velocity, the signature of the limit cycle. Clearance is the closest approach to an obstacle over the whole run, against a body radius of $0.35$~m; on the runs that fail it is the $0.25$~m at which the plant stops the robot against the wall. Time is reported only for runs that reached the goal. The \emph {long wall, gap north} row is taken at a spawn displaced $0.4$~m along the wall: with the goal on the axis the side is chosen by numerical noise, so a single run there compares the two spawns and not the two rules, and the sweep that establishes this is reported below}{table.caption.90}{}}
\newlabel{tab:escape@cref}{{[table][12][]12}{[1][30][]32}}
